{
    "name": "nozez-whatsmeow",
    "version": "1.0.6",
    "description": "High-performance WhatsApp bot library bridging Golang engine (whatsmeow) and Node.js via Stdio IPC",
    "type": "module",
    "main": "./src/index.cjs",
    "module": "./src/index.js",
    "exports": {
        ".": {
            "import": "./src/index.js",
            "require": "./src/index.cjs"
        }
    },
    "author": "Nozez",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nozez-lab/nozez-whatsmeow.git"
    },
    "bugs": {
        "url": "https://github.com/nozez-lab/nozez-whatsmeow/issues"
    },
    "homepage": "https://github.com/nozez-lab/nozez-whatsmeow#readme",
    "files": [
        "src",
        "go-engine",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build:win": "cd go-engine && go build -o main_win.exe main.go",
        "build:linux": "cd go-engine && GOOS=linux GOARCH=amd64 go build -o main_linux main.go"
    },
    "dependencies": {
        "ffmpeg-static": "^5.2.0",
        "sharp": "^0.33.5"
    }
}
